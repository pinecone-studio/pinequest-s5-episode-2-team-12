      {
        "id": "expr6",
        "type": "expression",
        "color": "#10b981",
        "latex": "\\text{CI}_{\\text{lower}} = (p - \\text{MOE}) \\times 100"
      },
      {
        "id": "expr7",
        "type": "expression",
        "color": "#000000",
        "latex": "\\text{CI}_{\\text{upper}} = (p + \\text{MOE}) \\times 100"
      },
      {
        "id": "expr8",
        "type": "expression",
        "color": "#000000",
        "latex": "\\text{Estimate} = \\hat{p} \\cdot N"
      },
      {
        "id": "expr9",
        "type": "expression",
        "color": "#000000",
        "latex": "\\text{MOE}_{4\\times} = \\frac{\\text{MOE}}{2}"
