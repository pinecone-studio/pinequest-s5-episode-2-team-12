{
  "name": "suprep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "bun test src ai scripts",
    "test:watch": "bun test --watch src ai scripts",
    "e2e": "playwright test",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "messages": "bun scripts/check-messages.ts",
    "seed:questions": "bun scripts/seed-questions.ts",
    "seed:journey": "bun scripts/seed-journey.ts",
    "roadmap:map": "bun scripts/roadmap/build-map.ts && biome format --write src/features/roadmap/map",
    "roadmap:terrain": "bun scripts/roadmap/fetch-terrain.ts && bun scripts/roadmap/build-terrain.ts",
    "roadmap:import": "bun scripts/roadmap/import-questions.ts",
    "roadmap:check-answers": "bun scripts/roadmap/check-answers.ts",
    "check": "biome check . && tsc --noEmit && bun run messages && bun test src ai scripts",
    "ai:build": "bun ai/pipeline/ingest.ts && bun ai/train/export.ts",
    "ai:eval": "bun ai/eval/run.ts"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "katex": "^0.16.22",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@babel/runtime": "^8.0.7",
    "@biomejs/biome": "2.2.4",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.2.22",
    "@types/d3-geo": "^3.1.1",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "d3-geo": "^3.1.1",
    "mapshaper": "^0.7.98",
    "sharp": "0.34.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "whatwg-mimetype": "^5.0.0"
  }
}
