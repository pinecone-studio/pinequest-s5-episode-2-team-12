# Хуулж .env.local болгоно. .env.local-ыг хэзээ ч commit хийхгүй.
# Хоосон үлдээвэл апп src/mocks/-ийн жишээ өгөгдлөөр, Суу демо горимоор ажиллана.

# Supabase (браузерт харагдаж болно — зөвхөн anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Зөвхөн server (NEXT_PUBLIC_ гэж ХЭЗЭЭ Ч эхлүүлэхгүй)
SUPABASE_SERVICE_ROLE_KEY=
# Existing legacy project: learning_questions; leave blank for the standard schema.
SUPABASE_QUESTIONS_TABLE=

# Gemini: AI Studio түлхүүр ЭСВЭЛ Vertex AI (project + location, gcloud auth application-default login)
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# AI багшийн чөлөөт чат (Суу Desmos хичээлээ бичнэ, чатыг Gemini). Зөвхөн GEMINI_API_KEY хэрэгтэй.
GEMINI_CHAT_MODEL=gemini-flash-latest
TUTOR_PROMPT_VERSION=v1

# Суу — fine-tune хийсэн жижиг модель (ai/train/suu_finetune.ipynb), Ollama дээр ажиллана.
# Хоосон эсвэл Ollama унтарсан үед Суу демо хариу өгнө.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=suu
# Laptop-оо tunnel-ээр холбосон үед (ai/serve/start.sh хэвлэнэ). Local Ollama-д хоосон.
OLLAMA_TOKEN=
# Загвар сурсан чадварууд: chat, desmos, planner, analyze (build.env-ийн SKILLS). Хоосон = бүгд. Суу v1: desmos.
OLLAMA_SKILLS=
